# Скопируйте в .env и заполните. .env никогда не коммитится в git.

NODE_ENV=production
PORT=10000

# Обязательно: случайная строка >=32 символов
SESSION_SECRET=

# URL для подключения к PostgreSQL (Render выдаст его при создании базы)
# Пример: postgres://user:pass@host.oregon-postgres.render.com/dbname
DATABASE_URL=

# Досеять базу тестовыми данными при первом запуске (по умолчанию true)
SEED_ON_INIT=true

# Учётка первого администратора
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-now

# На Render сервер всегда стоит за реверс-прокси, поэтому true
TRUST_PROXY=true
