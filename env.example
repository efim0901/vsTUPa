# Скопируйте в .env и заполните. .env никогда не коммитится в git.

NODE_ENV=development
PORT=3000

# Обязательно: случайная строка >=32 символов. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Путь к файлу базы данных (по умолчанию ./data/bteu.db)
DB_PATH=

# Досеять базу тестовыми данными при первом запуске (по умолчанию true)
SEED_ON_INIT=true

# Учётка первого администратора — используется ТОЛЬКО если в базе ещё
# нет ни одного admin-аккаунта. После первого запуска удалите эти две
# строки из .env, чтобы пароль не лежал на диске открытым текстом.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-now

# Установите true только если сервер стоит за доверенным реверс-прокси
# (nginx), который сам проставляет X-Forwarded-For.
TRUST_PROXY=false
